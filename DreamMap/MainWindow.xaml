<Window x:Class="DreamMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карта снов" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF070512"
        KeyDown="Window_KeyDown" FontFamily="Segoe UI">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="Root">
    <!-- небо -->
    <Canvas x:Name="Sky" IsHitTestVisible="False"/>

    <!-- карта: Map — неподвижный полноэкранный слой захвата; MapLayer держит узлы и масштабируется -->
    <Canvas x:Name="Map" Background="Transparent" MouseWheel="Map_Wheel"
            MouseLeftButtonDown="Map_PanDown" MouseMove="Map_PanMove" MouseLeftButtonUp="Map_PanUp">
      <Canvas x:Name="MapLayer"/>
    </Canvas>

    <!-- пустое состояние -->
    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="True">
      <TextBlock Text="Здесь родится карта ваших снов" FontFamily="Georgia" FontStyle="Italic"
                 FontSize="40" Foreground="#B6A9E8" HorizontalAlignment="Center">
        <TextBlock.Effect><DropShadowEffect Color="#9370FF" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/></TextBlock.Effect>
      </TextBlock>
      <TextBlock Text="Запишите первый сон — он станет первой звездой на карте.&#10;Каждый новый сон будет сам находить родственные:&#10;по местам, людям, чувствам и символам."
                 Foreground="#9A90C9" FontSize="14" TextAlignment="Center" Margin="0,16,0,22" LineHeight="22"/>
      <Button Style="{StaticResource Primary}" Content="✦ Записать первый сон" HorizontalAlignment="Center"
              Padding="22,10" Click="OpenNew_Click"/>
    </StackPanel>

    <!-- легенда -->
    <Border x:Name="Legend" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,40"
            Background="#9E16112E" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
            CornerRadius="12" Padding="14,8" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" x:Name="LegendItems"/>
    </Border>

    <!-- космос: список сновидцев справа (клик — открыть карту) -->
    <Border x:Name="DreamersPanel" Width="230" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,70,20,0" MaxHeight="620" Visibility="Collapsed"
            Background="#CC140F29" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
            CornerRadius="14" Padding="6">
      <StackPanel>
        <TextBlock Text="СНОВИДЦЫ" FontSize="11" Foreground="{StaticResource FaintBrush}"
                   Margin="10,6,0,6"/>
        <ScrollViewer MaxHeight="580" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="DreamersList"/>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- верхняя панель: кнопки окна и действия стоят справа первыми — при любой ширине на виду;
         редкое (космос, пользователи, импорт, настройки) — в меню ☰ -->
    <DockPanel VerticalAlignment="Top" Margin="18,12,16,0" LastChildFill="False"
               Background="Transparent" MouseLeftButtonDown="TopBar_MouseDown">
      <DockPanel.Resources>
        <Style x:Key="TB" TargetType="Button" BasedOn="{StaticResource Btn}">
          <Setter Property="Padding" Value="13,7"/>
          <Setter Property="FontSize" Value="13.5"/>
          <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="TBP" TargetType="Button" BasedOn="{StaticResource Primary}">
          <Setter Property="Padding" Value="13,7"/>
          <Setter Property="FontSize" Value="13.5"/>
          <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="TBG" TargetType="Button" BasedOn="{StaticResource Ghost}">
          <Setter Property="Padding" Value="11,7"/>
          <Setter Property="FontSize" Value="13.5"/>
          <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
      </DockPanel.Resources>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="6,0,0,0">
        <Button Style="{StaticResource TBG}" Content="—" Click="Minimize_Click" ToolTip="Свернуть в панель задач"/>
        <Button Style="{StaticResource TBG}" Content="🗖" Click="ToggleFS_Click" ToolTip="Окно / весь экран"/>
        <Button Style="{StaticResource TBG}" Content="✕" Click="Close_Click" ToolTip="Выход" Margin="0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Style="{StaticResource TBP}" Content="✦ Записать сон" Click="OpenNew_Click"/>
        <Button Style="{StaticResource TB}" Content="Сны" Click="ToggleList_Click"/>
        <Button Style="{StaticResource TB}" Content="📚 Библиотека" Click="Library_Click"
                ToolTip="Книги Скайрима, PDF и сюита: полки, чтение и трактовка через ИИ"/>
        <Button Style="{StaticResource TB}" Content="⛅ Сайт" Click="OpenSite_Click"
                ToolTip="Аккаунт на сайте: вход, синхронизация снов и книг"/>
        <Button x:Name="GiftsBtn" Style="{StaticResource TB}" Content="🎁" FontFamily="Segoe UI Emoji"
                Click="Gifts_Click" ToolTip="Ларец даров" Visibility="Collapsed"/>
        <Button x:Name="TrustBtn" Style="{StaticResource TB}" Content="🤝" FontFamily="Segoe UI Emoji"
                Click="Trust_Click" ToolTip="Связи доверия" Visibility="Collapsed"/>
        <Button x:Name="MoreBtn" Style="{StaticResource TB}" Content="☰" Click="More_Click"
                ToolTip="Ещё: космос, пользователи, импорт, настройки"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <TextBlock Text="☾" FontSize="21" Foreground="#CABEFC" VerticalAlignment="Center" Margin="0,0,8,2">
          <TextBlock.Effect><DropShadowEffect Color="#9370FF" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
        </TextBlock>
        <TextBlock Text="Карта снов" FontFamily="Georgia" FontSize="22" Foreground="#CABEFC" VerticalAlignment="Center"/>
        <Border x:Name="WhoChip" CornerRadius="12" Padding="10,3" Margin="12,3,0,0" Visibility="Collapsed"
                Background="#40251C52" BorderBrush="{StaticResource BorderBright}" BorderThickness="1"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="WhoAmI" FontSize="13" FontWeight="SemiBold" Foreground="#E6E0FF"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="WhoRole" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </DockPanel>

    <!-- меню ☰: то, что нужно не каждый день -->
    <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreBtn}" Placement="Bottom"
           StaysOpen="False" AllowsTransparency="True" VerticalOffset="6">
      <Border CornerRadius="14" Padding="6" MinWidth="210" BorderThickness="1"
              BorderBrush="{StaticResource BorderBright}" Background="#F61A1436">
        <StackPanel ButtonBase.Click="MoreItem_Click">
          <Button x:Name="CosmosBtn" Style="{StaticResource MenuRow}" Content="✦ Космос сновидцев"
                  Click="Cosmos_Click" Visibility="Collapsed"
                  ToolTip="Клик по сновидцу открывает его карту"/>
          <Button x:Name="UsersBtn" Style="{StaticResource MenuRow}" Content="👥 Пользователи"
                  FontFamily="Segoe UI Emoji, Segoe UI" Click="Users_Click" Visibility="Collapsed"
                  ToolTip="Управление сновидцами и инвайтами"/>
          <Button Style="{StaticResource MenuRow}" Content="⭱ Импорт снов" Click="Import_Click"
                  ToolTip="Импорт снов из файла dreams.json (копия базы с другого компьютера)"/>
          <Button Style="{StaticResource MenuRow}" Content="⚙ Настройки" Click="OpenSettings_Click"/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- левая панель: форма / список -->
    <Border x:Name="LeftPanel" Width="430" HorizontalAlignment="Left" Visibility="Collapsed"
            CornerRadius="0,20,20,0" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,26">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#F21A1436" Offset="0"/>
          <GradientStop Color="#F60E0A20" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="22,16,14,4">
          <TextBlock x:Name="LeftTitle" Text="Новый сон" FontFamily="Georgia" FontSize="22"
                     Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
          <Button Style="{StaticResource Ghost}" Content="✕" HorizontalAlignment="Right" Click="CloseLeft_Click"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,14,20">
          <Grid>
            <StackPanel x:Name="FormPanel">
              <TextBlock Text="НАЗВАНИЕ СНА" Style="{StaticResource Label}"/>
              <TextBox x:Name="FTitle" Style="{StaticResource Input}"/>
              <TextBlock Text="ДАТА" Style="{StaticResource Label}"/>
              <DatePicker x:Name="FDate" FontSize="14"/>
              <TextBlock Text="ЛОКАЦИЯ" Style="{StaticResource Label}"/>
              <ComboBox x:Name="FLoc" Style="{StaticResource Combo}"/>
              <TextBox x:Name="FLocNew" Style="{StaticResource Input}" Margin="0,6,0,0"
                       ToolTip="Своя локация: сон станет спутником её планеты"/>
              <TextBlock Text="Выберите прежнюю локацию или впишите свою в поле ниже — сон соединится с её снами в одну сеть. Без входа на сайт это единственный способ назвать место сна."
                         Foreground="{StaticResource FaintBrush}" FontSize="11.5" TextWrapping="Wrap"
                         Margin="2,5,0,0"/>
              <TextBlock Text="ЧТО СНИЛОСЬ" Style="{StaticResource Label}"/>
              <TextBox x:Name="FText" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="180" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"/>
              <Button x:Name="SaveBtn" Style="{StaticResource Primary}" Content="☾ Вплести в карту"
                      HorizontalAlignment="Right" Margin="0,18,0,0" Click="SaveDream_Click"/>
            </StackPanel>
            <StackPanel x:Name="ListPanel" Visibility="Collapsed"/>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- правая панель: детали -->
    <Border x:Name="RightPanel" Width="440" HorizontalAlignment="Right" Visibility="Collapsed"
            CornerRadius="20,0,0,20" BorderThickness="1,0,0,0" BorderBrush="{StaticResource BorderBrush2}" Margin="0,0,0,26">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#F21A1436" Offset="0"/>
          <GradientStop Color="#F60E0A20" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="22,16,14,4" LastChildFill="False">
          <TextBlock Text="Сон" FontFamily="Georgia" FontSize="22" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Style="{StaticResource Ghost}" Content="↻" FontSize="17" ToolTip="Достроить недостающее (анализ / картинку / связи)" Click="Redo_Click"/>
            <Button Style="{StaticResource Ghost}" Content="🗑" ToolTip="Удалить сон" Click="Delete_Click"/>
            <Button Style="{StaticResource Ghost}" Content="✕" Click="CloseRight_Click"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,14,20">
          <StackPanel x:Name="DetPanel"/>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- настройки -->
    <Grid x:Name="SettingsOverlay" Background="#B3040210" Visibility="Collapsed">
      <Border Width="520" VerticalAlignment="Center" CornerRadius="20" Padding="30,26"
              BorderBrush="{StaticResource BorderBright}" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1C1540" Offset="0"/>
            <GradientStop Color="#FF0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
          <TextBlock Text="Настройки" FontFamily="Georgia" FontSize="24" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="ИИ работает на сервере сайта: и толкование снов, и картинки. Ключ и выбор моделей — в вашем аккаунте на сайте, программа их не хранит и не выбирает."
                     Foreground="{StaticResource DimBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,14"/>
          <CheckBox x:Name="SGen" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" FontSize="13">
            <TextBlock Text="Рисовать картинку локации автоматически (иначе — спрашивать при каждом сне)"
                       TextWrapping="Wrap"/>
          </CheckBox>
          <DockPanel Margin="0,22,0,0" LastChildFill="False">
            <Button Style="{StaticResource Ghost}" Content="Папка данных" DockPanel.Dock="Left" Click="OpenData_Click"
                    ToolTip="Открыть папку, где лежат сны и картинки"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Style="{StaticResource Ghost}" Content="Отмена" Click="CloseSettings_Click" Margin="0,0,8,0"/>
              <Button Style="{StaticResource Primary}" Content="Сохранить" Click="SaveSettings_Click"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- сайт: аккаунт и синхронизация -->
    <Grid x:Name="SiteOverlay" Background="#B3040210" Visibility="Collapsed">
      <Border Width="540" VerticalAlignment="Center" CornerRadius="20" Padding="28,24"
              BorderBrush="{StaticResource BorderBright}" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1C1540" Offset="0"/>
            <GradientStop Color="#FF0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
          <TextBlock Text="⛅ Сайт «Карта снов»" FontFamily="Georgia" FontSize="23"
                     Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="АДРЕС САЙТА" Style="{StaticResource Label}"/>
          <TextBox x:Name="SUrl" Style="{StaticResource Input}"/>
          <TextBlock Text="ЛОГИН" Style="{StaticResource Label}"/>
          <TextBox x:Name="SSiteLogin" Style="{StaticResource Input}"/>
          <TextBlock Text="ПАРОЛЬ" Style="{StaticResource Label}"/>
          <PasswordBox x:Name="SSitePass" Background="#99080514" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush2}" Padding="10,8" FontSize="14"
                       CaretBrush="{StaticResource TextBrush}"/>
          <TextBlock Text="ИНВАЙТ-КОД (только для регистрации)" Style="{StaticResource Label}"/>
          <TextBox x:Name="SSiteInvite" Style="{StaticResource Input}"/>
          <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="SiteStatus" Foreground="{StaticResource FaintBrush}" FontSize="12"
                       VerticalAlignment="Center" DockPanel.Dock="Left" MaxWidth="240" TextWrapping="Wrap"/>
            <Button Style="{StaticResource Primary}" Content="Войти" Click="SiteLogin_Click" DockPanel.Dock="Right"/>
            <Button Style="{StaticResource Ghost}" Content="Регистрация" Click="SiteRegister_Click"
                    DockPanel.Dock="Right" Margin="0,0,8,0"/>
          </DockPanel>

          <StackPanel x:Name="SitePanel" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock x:Name="SiteRoleText" Foreground="#8FD8B8" FontSize="13"/>
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="SyncAllBtn" Style="{StaticResource Primary}" Content="⇅ Синхронизировать всё"
                      Click="SyncAll_Click" Margin="0,0,8,8"
                      ToolTip="Тянет с сайта всё, что доступно лично вам: сны и нити, позиции и вид карты, книги, PDF, палитру и ларец"/>
              <Button Style="{StaticResource Btn}" Content="⇅ Синхронизировать сны"
                      Click="SyncDreams_Click" Margin="0,0,8,8"/>
              <Button Style="{StaticResource Btn}" Content="⇅ Синхронизировать книги"
                      Click="SyncBooks_Click" Margin="0,0,8,8"/>
              <Button Style="{StaticResource Btn}" Content="🎁 Ларец даров"
                      Click="OpenLarets_Click" ToolTip="Открыть ларец даров" Margin="0,0,8,8"/>
              <Button Style="{StaticResource Ghost}" Content="Выйти из аккаунта" Click="SiteLogout_Click"
                      ToolTip="Забыть логин и пароль на этом компьютере: программа продолжит работать без ИИ"
                      Margin="0,0,8,8"/>
            </WrapPanel>
            <StackPanel x:Name="SiteAdmin" Visibility="Collapsed">
              <TextBlock Text="КОСМОС: КАРТЫ СНОВИДЦЕВ" Style="{StaticResource Label}"/>
              <DockPanel LastChildFill="False">
                <Button Style="{StaticResource Btn}" Content="✦ Открыть космос" Click="Cosmos_Click"
                        ToolTip="Каждый сновидец — звезда; клик открывает его карту"
                        DockPanel.Dock="Left"/>
                <Button Style="{StaticResource Ghost}" Content="Моя карта" Click="MyMap_Click" DockPanel.Dock="Right"/>
              </DockPanel>
            </StackPanel>
          </StackPanel>
          <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button Style="{StaticResource Ghost}" Content="Закрыть" Click="CloseSite_Click" DockPanel.Dock="Right"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- прогресс -->
    <Grid x:Name="ProgOverlay" Background="#B3040210" Visibility="Collapsed">
      <Border Width="400" VerticalAlignment="Center" CornerRadius="20" Padding="30,26"
              BorderBrush="{StaticResource BorderBright}" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1C1540" Offset="0"/>
            <GradientStop Color="#FF0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
          <TextBlock x:Name="ProgStars" Text="✦ ☾ ✦" FontSize="26" Foreground="#CABEFC"
                     HorizontalAlignment="Center" Margin="0,0,0,14"/>
          <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock x:Name="P1Icon" Text="◇" Width="28" FontSize="15" Foreground="#655D8F"/>
            <TextBlock x:Name="P1Text" Text="Толкование сна" FontSize="14.5" Foreground="#655D8F"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock x:Name="P2Icon" Text="◇" Width="28" FontSize="15" Foreground="#655D8F"/>
            <TextBlock x:Name="P2Text" Text="Картина локации" FontSize="14.5" Foreground="#655D8F"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock x:Name="P3Icon" Text="◇" Width="28" FontSize="15" Foreground="#655D8F"/>
            <TextBlock x:Name="P3Text" Text="Нити к другим снам" FontSize="14.5" Foreground="#655D8F"/>
          </StackPanel>
          <Button x:Name="ProgClose" Style="{StaticResource Btn}" Content="Закрыть" HorizontalAlignment="Center"
                  Margin="0,18,0,0" Visibility="Collapsed" Click="HideProg_Click"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- библиотека: полки книг из мода -->
    <Grid x:Name="LibOverlay" Background="#C7040210" Visibility="Collapsed">
      <Border Margin="44,36" CornerRadius="22" BorderThickness="1"
              BorderBrush="{StaticResource BorderBright}">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F81C1540" Offset="0"/>
            <GradientStop Color="#FC0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="26,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
          </Grid.RowDefinitions>
          <!-- закрытие и действия стоят справа первыми — при любой ширине они на виду -->
          <DockPanel LastChildFill="False">
            <Button Style="{StaticResource Ghost}" Content="✕" Click="LibClose_Click"
                    ToolTip="Закрыть библиотеку" DockPanel.Dock="Right"/>
            <Button x:Name="LibBrowseBtn" Style="{StaticResource Ghost}" Content="📂"
                    FontFamily="Segoe UI Emoji" Click="LibBrowse_Click" DockPanel.Dock="Right"
                    Margin="0,0,4,0" ToolTip="Открыть другой books.json…"/>
            <Button x:Name="NewItemBtn" Style="{StaticResource Primary}" Content="➕ Новая книга"
                    Click="NewBook_Click" DockPanel.Dock="Right" Margin="0,0,8,0"/>
            <Button x:Name="PickBtn" Style="{StaticResource Btn}" Content="☑ Выбрать"
                    ToolTip="Отметить несколько вещей и переложить разом"
                    Click="PickToggle_Click" Visibility="Collapsed" DockPanel.Dock="Right" Margin="0,0,8,0"/>
            <TextBlock Text="📚 Библиотека" FontFamily="Segoe UI Emoji, Georgia" VerticalAlignment="Center"
                       FontSize="20" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="14,0,0,0">
              <Button x:Name="TabHiero" Style="{StaticResource Primary}" Content="𓏛 Иероглифы"
                      Click="TabHiero_Click" Margin="0,0,6,0"/>
              <Button x:Name="TabPdf" Style="{StaticResource Btn}" Content="📕 PDF" Click="TabPdf_Click"
                      Margin="0,0,6,0"/>
              <Button x:Name="TabSuite" Style="{StaticResource Btn}" Content="⚙ Сюита" Click="TabSuite_Click"/>
            </StackPanel>
          </DockPanel>
          <!-- сколько всего на полке (где лежит — в подсказке), шапка папки и отбор нескольких вещей -->
          <StackPanel Grid.Row="1">
            <TextBlock x:Name="LibStatus" Foreground="{StaticResource FaintBrush}" FontSize="11.5"
                       Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
            <Border x:Name="FolderHead" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,8"
                    CornerRadius="12" BorderThickness="1" BorderBrush="#55B9975A">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#804A3B22" Offset="0"/>
                  <GradientStop Color="#661A1338" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <DockPanel LastChildFill="False">
                <Button Style="{StaticResource Ghost}" Content="⬅" ToolTip="Назад на общую полку"
                        Click="FolderBack_Click" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                <TextBlock x:Name="FolderHeadName" FontSize="14.5" FontWeight="SemiBold"
                           Foreground="#FCD34D" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock x:Name="FolderHeadCount" FontSize="12" Margin="10,0,0,0"
                           Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                <Button Style="{StaticResource Ghost}" Content="🗑" FontFamily="Segoe UI Emoji"
                        ToolTip="Убрать папку — вещи вернутся на общую полку"
                        Click="FolderDel_Click" DockPanel.Dock="Right"/>
                <Button Style="{StaticResource Ghost}" Content="✎" ToolTip="Переименовать папку"
                        Click="FolderRename_Click" DockPanel.Dock="Right" Margin="0,0,4,0"/>
              </DockPanel>
            </Border>
            <Border x:Name="PickBar" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,7"
                    CornerRadius="12" Background="#40251C52"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
              <DockPanel LastChildFill="False">
                <TextBlock x:Name="PickCount" Foreground="{StaticResource DimBrush}" FontSize="12.5"
                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button Style="{StaticResource Ghost}" Content="Отмена" Click="PickOff_Click" DockPanel.Dock="Right"/>
                <Button Style="{StaticResource Primary}" Content="Переложить" Click="MovePicked_Click"
                        DockPanel.Dock="Right" Margin="0,0,8,0"/>
                <ComboBox x:Name="PickTarget" Style="{StaticResource Combo}" Width="240"
                          DockPanel.Dock="Right" Margin="0,0,10,0"/>
              </DockPanel>
            </Border>
          </StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <WrapPanel x:Name="Shelves"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- читалка PDF: страницы — картинки, текст не копируется -->
    <Grid x:Name="PdfOverlay" Background="#C7040210" Visibility="Collapsed">
      <Border Margin="110,50" CornerRadius="22" BorderThickness="1"
              BorderBrush="{StaticResource BorderBright}">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FA1C1540" Offset="0"/>
            <GradientStop Color="#FD0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="26,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="False">
            <TextBlock x:Name="PdfTitle" FontFamily="Georgia" FontSize="22"
                       Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <TextBlock x:Name="PdfStatus" Foreground="{StaticResource FaintBrush}" FontSize="12"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button Style="{StaticResource Ghost}" Content="➖" ToolTip="Отдалить (Ctrl+колёсико)" Click="PdfZoomOut_Click"/>
              <TextBlock x:Name="PdfZoomText" Text="100%" Foreground="{StaticResource DimBrush}" FontSize="12.5"
                         VerticalAlignment="Center" MinWidth="42" TextAlignment="Center"/>
              <Button Style="{StaticResource Ghost}" Content="➕" ToolTip="Приблизить (Ctrl+колёсико)" Click="PdfZoomIn_Click"/>
              <Button Style="{StaticResource Ghost}" Content="🔗" ToolTip="Связать с другой книгой (нужен вход в ⛅ Сайт)" Click="PdfLink_Click"/>
              <Button Style="{StaticResource Ghost}" Content="🗑" ToolTip="Удалить PDF" Click="PdfDel_Click"/>
              <Button Style="{StaticResource Ghost}" Content="✕" Click="PdfClose_Click"/>
            </StackPanel>
          </DockPanel>
          <StackPanel x:Name="PdfLinksPanel" Grid.Row="1" Margin="0,6,0,0"/>
          <ScrollViewer x:Name="PdfScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto" Margin="0,12,0,0"
                        PreviewMouseWheel="PdfScroll_Wheel" ScrollChanged="PdfScroll_Changed">
            <StackPanel x:Name="PdfPages" HorizontalAlignment="Center"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- правка записи сна -->
    <Grid x:Name="EditTextOverlay" Background="#C7040210" Visibility="Collapsed">
      <Border Width="640" VerticalAlignment="Center" CornerRadius="20" Padding="28,24"
              BorderBrush="{StaticResource BorderBright}" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1C1540" Offset="0"/>
            <GradientStop Color="#FF0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
          <TextBlock x:Name="EditTextHead" Text="Правка записи" FontFamily="Georgia" FontSize="23"
                     Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="Толкование, картина и нити остаются прежними — их можно достроить заново кнопкой ↻."
                     Foreground="{StaticResource DimBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
          <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource Label}"/>
          <TextBox x:Name="EdTitle" Style="{StaticResource Input}"/>
          <TextBlock Text="ЧТО СНИЛОСЬ" Style="{StaticResource Label}"/>
          <TextBox x:Name="EdText" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="240" VerticalScrollBarVisibility="Auto"
                   FontFamily="Segoe UI Historic, Segoe UI" FontSize="14"/>
          <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button Style="{StaticResource Ghost}" Content="Отмена" Click="EditTextCancel_Click" DockPanel.Dock="Right"/>
            <Button Style="{StaticResource Primary}" Content="☾ Сохранить" Click="EditTextSave_Click"
                    DockPanel.Dock="Right" Margin="0,0,8,0"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- новая книга -->
    <Grid x:Name="NewBookOverlay" Background="#C7040210" Visibility="Collapsed">
      <Border Width="640" VerticalAlignment="Center" CornerRadius="20" Padding="28,24"
              BorderBrush="{StaticResource BorderBright}" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1C1540" Offset="0"/>
            <GradientStop Color="#FF0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel>
          <TextBlock x:Name="NbHead" Text="Новая книга" FontFamily="Georgia" FontSize="23"
                     Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="Книга встанет на полку и в books.json мода — Писец вошьёт её в игру."
                     Foreground="{StaticResource DimBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
          <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource Label}"/>
          <TextBox x:Name="NbTitle" Style="{StaticResource Input}"/>
          <TextBlock Text="ТЕКСТ (иероглифы и русский)" Style="{StaticResource Label}"/>
          <TextBox x:Name="NbText" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="230" VerticalScrollBarVisibility="Auto"
                   FontFamily="Segoe UI Historic, Segoe UI" FontSize="15"/>
          <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button Style="{StaticResource Ghost}" Content="Отмена" Click="NewBookCancel_Click" DockPanel.Dock="Right"/>
            <Button Style="{StaticResource Primary}" Content="☾ На полку" Click="NewBookSave_Click"
                    DockPanel.Dock="Right" Margin="0,0,8,0"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- читальня -->
    <Grid x:Name="ReadOverlay" Background="#C7040210" Visibility="Collapsed">
      <Border Margin="120,60" CornerRadius="22" BorderThickness="1"
              BorderBrush="{StaticResource BorderBright}">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FA1C1540" Offset="0"/>
            <GradientStop Color="#FD0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="30,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="False">
            <TextBlock x:Name="ReadTitle" FontFamily="Georgia" FontSize="23"
                       Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
            <Button Style="{StaticResource Ghost}" Content="✕" Click="ReadClose_Click" DockPanel.Dock="Right"/>
            <Button Style="{StaticResource Ghost}" Content="🗑" FontFamily="Segoe UI Emoji"
                    Click="BookDel_Click" ToolTip="Удалить книгу" DockPanel.Dock="Right"/>
            <Button Style="{StaticResource Ghost}" Content="🎁" FontFamily="Segoe UI Emoji"
                    Click="BookGive_Click" ToolTip="Предложить книгу в дар" DockPanel.Dock="Right"/>
            <Button Style="{StaticResource Ghost}" Content="✏" Click="BookEdit_Click"
                    ToolTip="Изменить книгу" DockPanel.Dock="Right"/>
            <Button Style="{StaticResource Ghost}" Content="🔗" Click="BookLink_Click"
                    ToolTip="Связать с другой книгой (нужен вход в ⛅ Сайт)" DockPanel.Dock="Right"/>
            <Button Style="{StaticResource Ghost}" Content="🪐" FontFamily="Segoe UI Emoji"
                    Click="BookFoundation_Click" DockPanel.Dock="Right"
                    ToolTip="Фундамент: книга подпирает планету-локацию"/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
              <StackPanel x:Name="ReadLinksPanel" Margin="0,0,0,6"/>
              <TextBlock x:Name="ReadText" TextWrapping="Wrap" FontSize="16" LineHeight="27"
                         FontFamily="Segoe UI Historic, Segoe UI" Foreground="{StaticResource TextBrush}"/>
              <TextBlock x:Name="ReadTransHead" Text="ТРАКТОВКА ЖРЕЦА-ИИ" FontSize="11"
                         Foreground="{StaticResource FaintBrush}" Margin="0,22,0,4" Visibility="Collapsed"/>
              <TextBlock x:Name="ReadTrans" TextWrapping="Wrap" FontSize="14.5" LineHeight="24"
                         FontStyle="Italic" Foreground="#C4BBEA" Visibility="Collapsed"/>
            </StackPanel>
          </ScrollViewer>
          <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="ReadStatus" Foreground="{StaticResource FaintBrush}" FontSize="12.5"
                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button x:Name="InterpretBtn" Style="{StaticResource Primary}" Content="☥ Трактовать через ИИ"
                    Click="Interpret_Click" DockPanel.Dock="Right"/>
            <ComboBox x:Name="KeyCombo" Style="{StaticResource Combo}" Width="300" DockPanel.Dock="Right"
                      Margin="0,0,10,0" ToolTip="Ключ трактовки — из книги «Ключи к трактовке»"/>
            <TextBlock Text="КЛЮЧ:" Foreground="{StaticResource FaintBrush}" FontSize="11"
                       VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,8,0"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- выбор картинки локации -->
    <Grid x:Name="ImgOverlay" Background="#B3040210" Visibility="Collapsed">
      <Border Width="600" MaxHeight="640" VerticalAlignment="Center" CornerRadius="20" Padding="28,24"
              BorderBrush="{StaticResource BorderBright}" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1C1540" Offset="0"/>
            <GradientStop Color="#FF0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Картина локации" FontFamily="Georgia" FontSize="23"
                     Foreground="{StaticResource TextBrush}"/>
          <TextBlock x:Name="ImgLocText" Grid.Row="1" Foreground="{StaticResource DimBrush}" FontSize="13"
                     TextWrapping="Wrap" Margin="0,6,0,12"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="ImgGallery"/>
          </ScrollViewer>
          <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <Button Style="{StaticResource Ghost}" Content="Без картинки" DockPanel.Dock="Left" Click="ImgNone_Click"/>
            <Button Style="{StaticResource Primary}" Content="✨ Нарисовать с нуля" DockPanel.Dock="Right" Click="ImgGen_Click"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- пользователи и инвайты (админ и выше) -->
    <Grid x:Name="UsersOverlay" Background="#C7040210" Visibility="Collapsed">
      <Border Width="880" MaxHeight="760" VerticalAlignment="Center" CornerRadius="20" Padding="26,22"
              BorderBrush="{StaticResource BorderBright}" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1C1540" Offset="0"/>
            <GradientStop Color="#FF0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="False">
            <TextBlock Text="Пользователи" FontFamily="Georgia" FontSize="23"
                       Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
            <Button Style="{StaticResource Ghost}" Content="✕" Click="UsersClose_Click" DockPanel.Dock="Right"/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
              <StackPanel x:Name="UsersList"/>
              <TextBlock Text="ИНВАЙТЫ — ВХОД ТОЛЬКО ПО НИМ" Style="{StaticResource Label}"/>
              <StackPanel x:Name="InvitesList"/>
            </StackPanel>
          </ScrollViewer>
          <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button Style="{StaticResource Btn}" Content="➕ Создать инвайт" Click="InviteCreate_Click"
                    DockPanel.Dock="Left"/>
            <Button x:Name="PurgeInvitesBtn" Style="{StaticResource Ghost}" Content="🧹 Очистить использованные"
                    Click="InvitesPurge_Click" DockPanel.Dock="Left" Margin="8,0,0,0" Visibility="Collapsed"
                    ToolTip="Убрать из списка все использованные инвайты (только владелец)"/>
            <Button Style="{StaticResource Ghost}" Content="Закрыть" Click="UsersClose_Click" DockPanel.Dock="Right"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ларец даров -->
    <Grid x:Name="GiftsOverlay" Background="#C7040210" Visibility="Collapsed">
      <Border Width="700" MaxHeight="720" VerticalAlignment="Center" CornerRadius="20" Padding="26,22"
              BorderBrush="{StaticResource BorderBright}" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1C1540" Offset="0"/>
            <GradientStop Color="#FF0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <DockPanel LastChildFill="False">
              <TextBlock Text="🎁 Ларец даров" FontFamily="Segoe UI Emoji, Georgia" FontSize="23"
                         Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
              <Button Style="{StaticResource Ghost}" Content="✕" Click="GiftsClose_Click" DockPanel.Dock="Right"/>
            </DockPanel>
            <TextBlock Text="Ничто не входит в ваш космос без согласия. Неугодный дар можно скормить чёрной дыре — он исчезнет и у вас, и у дарителя."
                       Foreground="{StaticResource DimBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel x:Name="GiftsList"/>
          </ScrollViewer>
          <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button Style="{StaticResource Ghost}" Content="Закрыть" Click="GiftsClose_Click" DockPanel.Dock="Right"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- связи доверия -->
    <Grid x:Name="TrustOverlay" Background="#C7040210" Visibility="Collapsed">
      <Border Width="620" MaxHeight="680" VerticalAlignment="Center" CornerRadius="20" Padding="26,22"
              BorderBrush="{StaticResource BorderBright}" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1C1540" Offset="0"/>
            <GradientStop Color="#FF0F0B24" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="False">
            <TextBlock Text="🤝 Доверие" FontFamily="Segoe UI Emoji, Georgia" FontSize="23"
                       Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
            <Button Style="{StaticResource Ghost}" Content="✕" Click="TrustClose_Click" DockPanel.Dock="Right"/>
          </DockPanel>
          <StackPanel Grid.Row="1">
            <TextBlock Text="Доверие взаимно и отзываемо. Доверенные могут дарить друг другу; автоприём кладёт их дары на полку без вопросов."
                       Foreground="{StaticResource DimBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <DockPanel>
              <Button Style="{StaticResource Primary}" Content="Предложить" Click="TrustRequest_Click"
                      DockPanel.Dock="Right" Margin="8,0,0,0"/>
              <TextBox x:Name="TrustLogin" Style="{StaticResource Input}" Margin="0"/>
            </DockPanel>
            <TextBlock Text="СВЯЗИ" Style="{StaticResource Label}"/>
          </StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TrustList"/>
          </ScrollViewer>
          <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button Style="{StaticResource Ghost}" Content="Закрыть" Click="TrustClose_Click" DockPanel.Dock="Right"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- чёрная дыра: не кнопка, а место — сюда падают скормленные дары -->
    <Grid Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Bottom"
          Margin="0,0,26,44" IsHitTestVisible="False">
      <Ellipse StrokeThickness="7" RenderTransformOrigin="0.5,0.5">
        <Ellipse.Stroke>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00A78BFA" Offset="0"/>
            <GradientStop Color="#C0A78BFA" Offset="0.45"/>
            <GradientStop Color="#907DD3FC" Offset="0.7"/>
            <GradientStop Color="#00A78BFA" Offset="1"/>
          </LinearGradientBrush>
        </Ellipse.Stroke>
        <Ellipse.RenderTransform>
          <RotateTransform x:Name="BhSpin" Angle="0"/>
        </Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Margin="14" Fill="#000000">
        <Ellipse.Effect>
          <DropShadowEffect Color="#9370FF" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
        </Ellipse.Effect>
      </Ellipse>
    </Grid>

    <!-- строка состояния: что делает синхронизация и полоса её хода -->
    <Border x:Name="StatusBar" VerticalAlignment="Bottom" Height="26" Padding="18,0,16,0"
            Background="#D90B0820" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <ProgressBar x:Name="SyncBar" Width="200" Height="5" Minimum="0" Maximum="100"
                       Visibility="Collapsed" VerticalAlignment="Center">
            <ProgressBar.Template>
              <ControlTemplate TargetType="ProgressBar">
                <Grid>
                  <Border x:Name="PART_Track" CornerRadius="3" Background="#2EA78BFA"/>
                  <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#8B7CF8" Offset="0"/>
                        <GradientStop Color="#7DD3FC" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                </Grid>
              </ControlTemplate>
            </ProgressBar.Template>
          </ProgressBar>
          <TextBlock x:Name="SyncPct" FontSize="11.5" Foreground="{StaticResource DimBrush}"
                     Margin="10,0,0,0" MinWidth="38" TextAlignment="Right" Visibility="Collapsed"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="сайт не подключён" FontSize="12"
                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <!-- toast -->
    <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,42"
            Background="#FF141029" BorderBrush="{StaticResource BorderBright}" BorderThickness="1"
            CornerRadius="12" Padding="20,10" Visibility="Collapsed" MaxWidth="640">
      <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontSize="13.5" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
