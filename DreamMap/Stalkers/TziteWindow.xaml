<Window x:Class="DreamMap.Stalkers.TziteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tz'ite"
        Height="660"
        Width="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#071310"
        FontFamily="Consolas">
    <Window.Resources>
        <SolidColorBrush x:Key="Jade" Color="#2FD6A6"/>
        <SolidColorBrush x:Key="Cinnabar" Color="#E34234"/>
        <SolidColorBrush x:Key="PanelBg" Color="#0A1A15"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#1E5C48"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC7B0"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Jade}"/>
            <Setter Property="Background" Value="#0C231C"/>
            <Setter Property="BorderBrush" Value="#2FD6A6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glow" BorderBrush="#E34234" BorderThickness="2"
                                    CornerRadius="2" Opacity="0.0"/>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#103026"/>
                                <Setter Property="BorderBrush" Value="#E34234"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                From="#2FD6A6" To="#E34234" Duration="0:0:0.7"/>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0.0" To="0.45" Duration="0:0:0.7"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#081813"/>
                                <Setter Property="BorderBrush" Value="#2FD6A6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#122C24"/>
                                <Setter Property="Foreground" Value="{StaticResource Cinnabar}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#061210"/>
            <Setter Property="Foreground" Value="{StaticResource Jade}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource Jade}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0A1A15" BorderBrush="#1E5C48" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TZ'ITE // AJQ'IJ" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="1" Text="семена считают четвёрками — день отвечает"
                           Foreground="#4E9C80" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="✕" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- день сна и вопрос -->
            <Border CornerRadius="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBg}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ДЕНЬ СНА" Foreground="{StaticResource Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="DateBox" Grid.Column="1" ToolTip="ГГГГ-ММ-ДД"/>
                    <TextBlock Grid.Column="2" Text="ВОПРОС" Foreground="{StaticResource Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox x:Name="AskBox" Grid.Column="3"
                             ToolTip="о чём спрашиваешь семена: сбудется ли, к добру ли, идти ли"/>
                    <Button Grid.Column="4" Content="БРОСИТЬ СЕМЕНА" Click="Cast_Click" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- день цолькина -->
            <Border Grid.Row="1" CornerRadius="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBg}" Padding="14" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ДЕНЬ, В КОТОРЫЙ ПРИСНИЛОСЬ" Foreground="#4E9C80" FontSize="11"/>
                        <TextBlock x:Name="DayName" Text="—" Foreground="{StaticResource Jade}" FontSize="26"/>
                        <TextBlock x:Name="DayRu" Text="" Foreground="{StaticResource Muted}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ДЕНЬ-ОТВЕТ, НА КОТОРОМ ЗАМЕР СЧЁТ" Foreground="#4E9C80" FontSize="11"/>
                        <TextBlock x:Name="AnsName" Text="—" Foreground="{StaticResource Cinnabar}" FontSize="26"/>
                        <TextBlock x:Name="AnsRu" Text="" Foreground="{StaticResource Muted}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- горсть семян, разложенная по четыре -->
            <Border Grid.Row="2" CornerRadius="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBg}" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="HandLine" Text="ГОРСТЬ НЕ БРОШЕНА" Foreground="#4E9C80" FontSize="11"/>
                    <ItemsControl x:Name="Seeds" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ответ -->
            <Border Grid.Row="3" CornerRadius="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBg}" Padding="14" Margin="0,10,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Reading"
                               Text="Хранитель дней берёт горсть красных семян цитэ и раскладывает их по четыре. Число кучек уводит счёт вперёд по цолькину, остаток говорит, каков ответ. Впиши день сна и вопрос — и бросай."
                               Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" LineHeight="24"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
