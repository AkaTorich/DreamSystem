<Window x:Class="DreamMap.Stalkers.TonalpohualliWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tonalpohualli"
        Height="640"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#0D0B08"
        FontFamily="Consolas">
    <Window.Resources>
        <SolidColorBrush x:Key="Turquoise" Color="#45E0C8"/>
        <SolidColorBrush x:Key="Gold" Color="#F2B33D"/>
        <SolidColorBrush x:Key="Blood" Color="#C1440E"/>
        <SolidColorBrush x:Key="PanelBg" Color="#120E0A"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#5C4A1A"/>
        <SolidColorBrush x:Key="Muted" Color="#C9A86A"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="Background" Value="#1B140C"/>
            <Setter Property="BorderBrush" Value="#F2B33D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glow" BorderBrush="#45E0C8" BorderThickness="2"
                                    CornerRadius="2" Opacity="0.0"/>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#241A0F"/>
                                <Setter Property="BorderBrush" Value="#45E0C8"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                From="#F2B33D" To="#45E0C8" Duration="0:0:0.7"/>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0.0" To="0.45" Duration="0:0:0.7"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#15100A"/>
                                <Setter Property="BorderBrush" Value="#F2B33D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A1E10"/>
                                <Setter Property="Foreground" Value="{StaticResource Turquoise}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A0806"/>
            <Setter Property="Foreground" Value="{StaticResource Turquoise}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource Turquoise}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- титульная полоса: как у соседних окон -->
        <Border Grid.Row="0" Background="#120E0A" BorderBrush="#5C4A1A" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TONALPOHUALLI // 260"
                           Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="1" Text="счёт дней — день говорит за сон"
                           Foreground="#8C6A3A" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="✕" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ввод: день сна и его образ -->
            <Border CornerRadius="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBg}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ДЕНЬ СНА" Foreground="{StaticResource Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="DateBox" Grid.Column="1" ToolTip="ГГГГ-ММ-ДД"/>
                    <TextBlock Grid.Column="2" Text="ОБРАЗ" Foreground="{StaticResource Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox x:Name="SignBox" Grid.Column="3"
                             ToolTip="что виделось: змея, вода, дом, погоня…"/>
                    <Button Grid.Column="4" Content="СПРОСИТЬ ДЕНЬ" Click="Ask_Click" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- клетка календаря -->
            <Border Grid.Row="1" CornerRadius="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBg}" Padding="14" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- число точками, как в кодексах -->
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="NumBig" Text="—" Foreground="{StaticResource Gold}"
                                   FontSize="52" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <ItemsControl x:Name="Dots" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Width="92" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="SignName" Text="день не назван"
                                   Foreground="{StaticResource Turquoise}" FontSize="26"/>
                        <TextBlock x:Name="SignRu" Text="" Foreground="{StaticResource Muted}" FontSize="14"
                                   Margin="0,2,0,0"/>
                        <TextBlock x:Name="Meta" Text="" Foreground="#8C6A3A" FontSize="12.5"
                                   TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- толкование -->
            <Border Grid.Row="2" CornerRadius="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBg}" Padding="14" Margin="0,10,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Reading"
                               Text="Впиши день, в который приснился сон, и образ из него. Тональпоуалли ответит: не образ решает, а его пересечение с днём."
                               Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" LineHeight="24"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
