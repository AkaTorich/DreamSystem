<Window x:Class="DreamMap.Stalkers.ObiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obi"
        Height="668"
        Width="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#000000"
        FontFamily="Consolas">
    <Window.Resources>
        <SolidColorBrush x:Key="Efun" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="Osun" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Indigo" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="PanelBg" Color="#000000"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#444444"/>
        <SolidColorBrush x:Key="Muted" Color="#9A9A9A"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Efun}"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glow" BorderBrush="#FFFFFF" BorderThickness="2"
                                    CornerRadius="2" Opacity="0.0"/>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                From="#C8C8C8" To="#FFFFFF" Duration="0:0:0.7"/>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0.0" To="0.5" Duration="0:0:0.7"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0E0E0E"/>
                                <Setter Property="BorderBrush" Value="#C8C8C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#444444"/>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="{StaticResource Osun}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="{StaticResource Efun}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource Efun}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#000000" BorderBrush="#444444" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="OBI // ELÉGBÁRA" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="1" Text="орех не толкует сон — он подтверждает или отвергает догадку"
                           Foreground="#808080" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="✕" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- сон и догадка -->
            <Border CornerRadius="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBg}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СОН О" Foreground="{StaticResource Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="AboutBox" Grid.Column="1" ToolTip="образ или символ сна — о чём он"/>
                    <TextBlock Grid.Column="2" Text="ДОГАДКА" Foreground="{StaticResource Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox x:Name="GuessBox" Grid.Column="3"
                             ToolTip="что спрашиваешь у ореха — «да/нет»: этот сон предупреждение, нужно ли подношение…"/>
                    <Button Grid.Column="4" Content="БРОСИТЬ ОРЕХ" Click="Cast_Click" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- готовые вопросы обряда и перевод терминов -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <WrapPanel>
                    <TextBlock Text="СПРОСИТЬ:" Foreground="#808080" FontSize="11"
                               VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <Button Style="{StaticResource Chip}" Tag="этот сон — весть Ориши" Content="от Ориши?"
                            Click="Preset_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource Chip}" Tag="этот сон — от предков" Content="от предков?"
                            Click="Preset_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource Chip}" Tag="этот сон — козни аджогун" Content="от врага?"
                            Click="Preset_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource Chip}" Tag="этот сон — предупреждение" Content="предупреждение?"
                            Click="Preset_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource Chip}" Tag="нужно ли подношение (эбо)" Content="нужно подношение?"
                            Click="Preset_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource Chip}" Tag="долг отдан, сон закрыт" Content="долг принят?"
                            Click="Preset_Click" Margin="0,0,6,0"/>
                </WrapPanel>
                <TextBlock Margin="2,7,0,0" Foreground="#808080" FontSize="11" TextWrapping="Wrap">
                    <Run Foreground="#FFFFFF">ориша</Run><Run> — божества-покровители йоруба, посланцы Единого (Олодумаре);   </Run>
                    <Run Foreground="#FFFFFF">эгбе</Run><Run> — небесные двойники, «товарищи» души, оставшиеся на небе;   </Run>
                    <Run Foreground="#FFFFFF">аджогун</Run><Run> — злые силы, колдовство врага.</Run>
                </TextBlock>
            </StackPanel>

            <!-- четыре доли ореха и фигура -->
            <Border Grid.Row="2" CornerRadius="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBg}" Padding="14" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" x:Name="Lobes" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock x:Name="CastLine" Text="ОРЕХ ЕЩЁ НЕ БРОШЕН" Foreground="#808080" FontSize="11"/>
                        <TextBlock x:Name="FigName" Text="—" Foreground="{StaticResource Efun}" FontSize="30"/>
                        <TextBlock x:Name="FigRu" Text="" Foreground="{StaticResource Osun}" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ответ -->
            <Border Grid.Row="3" CornerRadius="3" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBg}" Padding="14" Margin="0,10,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Reading"
                               Text="Оби — не сонник. Сначала догадайся, о чём сон и от кого он (ориша — божества-покровители, предки, эгбе — небесные двойники души, или враг), а потом спроси у ореха: «правильно ли я тебя понял?». Спрашивают утром, натощак, у порога Эшу-Элегба — он привратник, через него проходят и сны, и ответы. Впиши догадку и брось четыре доли ореха."
                               Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" LineHeight="24"/>
                </ScrollViewer>
            </Border>
        </Grid>
        <!-- бегущие муравьи: белый пунктир по краю окна, как у прочих гаданий -->
        <Rectangle x:Name="FrameGlow"
                   Grid.RowSpan="2"
                   Margin="2"
                   IsHitTestVisible="False"
                   Stroke="#E8E8E8"
                   StrokeThickness="1.2"
                   StrokeDashArray="4 3"
                   Opacity="0.6">
            <Rectangle.Effect>
                <DropShadowEffect Color="#E8E8E8"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.5"/>
            </Rectangle.Effect>
        </Rectangle>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- бег пунктира: своё бесконечное повторение, чтобы не было пауз -->
                    <DoubleAnimation Storyboard.TargetName="FrameGlow"
                                     Storyboard.TargetProperty="StrokeDashOffset"
                                     From="0"
                                     To="-14"
                                     Duration="0:0:2"
                                     RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="FrameGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.45"
                                     To="0.8"
                                     AutoReverse="True"
                                     Duration="0:0:1.2"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
