<Window x:Class="DreamMap.Stalkers.IChingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="I Ching Generator"
        Height="520"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#0B0F0B"
        FontFamily="Consolas">
    <Window.Resources>
        <SolidColorBrush x:Key="NeonGreen" Color="#39FF14"/>
        <SolidColorBrush x:Key="DeepGreen" Color="#0B2D12"/>
        <SolidColorBrush x:Key="PanelBg" Color="#0A120C"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#1A5C2C"/>
        <SolidColorBrush x:Key="MutedGreen" Color="#5CFF9E"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource NeonGreen}"/>
            <Setter Property="Background" Value="#0F1B12"/>
            <Setter Property="BorderBrush" Value="#39FF14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glow"
                                    BorderBrush="#39FF14"
                                    BorderThickness="2"
                                    CornerRadius="2"
                                    Opacity="0.0"/>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#142418"/>
                                <Setter Property="BorderBrush" Value="#5CFF9E"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <ColorAnimation Storyboard.TargetName="border"
                                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                            From="#39FF14"
                                                            To="#5CFF9E"
                                                            Duration="0:0:0.6"/>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.0"
                                                             To="0.5"
                                                             Duration="0:0:0.6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0C150E"/>
                                <Setter Property="BorderBrush" Value="#39FF14"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#0A120C"/>
            <Setter Property="BorderBrush" Value="#1A5C2C"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#152419"/>
                    <Setter Property="BorderBrush" Value="#5CFF9E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0A120C"/>
                    <Setter Property="BorderBrush" Value="#39FF14"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource NeonGreen}"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="#1A5C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource NeonGreen}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#5CFF9E"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#39FF14"/>
                    <Setter Property="Background" Value="#0E1810"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="FocusPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <ColorAnimation Storyboard.TargetProperty="(TextBox.BorderBrush).(SolidColorBrush.Color)"
                                                From="#39FF14"
                                                To="#5CFF9E"
                                                Duration="0:0:0.7"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="FocusPulse"/>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScrollbarRepeatButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0A120C"/>
            <Setter Property="BorderBrush" Value="#1A5C2C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollbarRepeatButton}"
                                                  Command="ScrollBar.LineUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#1A5C2C"
                                           BorderBrush="#1A5C2C"
                                           BorderThickness="1"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollbarRepeatButton}"
                                                  Command="ScrollBar.LineDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0E1810"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Background" Value="#1A5C2C"/>
            <Setter Property="BorderBrush" Value="#1A5C2C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MutedGreen}"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="{StaticResource NeonGreen}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кастомная панель заголовка -->
        <Border Grid.Row="0"
                Background="#0A120C"
                BorderBrush="#1A5C2C"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="I CHING // GEN"
                           Foreground="{StaticResource MutedGreen}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>

                <TextBlock Grid.Column="1"
                           Text="00x — CONSOLE"
                           Foreground="#2AFF7A"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}"
                            Content="—"
                            Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleBarButton}"
                            Content="✕"
                            Click="Close_Click"/>
                </StackPanel>

                <Rectangle Fill="Transparent"
                           Grid.ColumnSpan="3"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="184"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="3"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBg}"
                    Padding="10">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="I CHING :: GEN"
                               Foreground="{StaticResource MutedGreen}"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="v1.0"
                               Foreground="{StaticResource MutedGreen}"
                               FontSize="12"
                               Margin="8,6,0,0"
                               DockPanel.Dock="Left"/>
                    <Button x:Name="generateButton"
                            Content="ГЕНЕРАЦИЯ"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Click="Generate_Click"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,8,0,0"
                    CornerRadius="3"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="CONSOLE OUTPUT"
                           Foreground="{StaticResource MutedGreen}"
                           FontSize="12"
                           Margin="10,8,0,0"/>
                <TextBox x:Name="resultTextBox"
                         Grid.Row="1"
                         Margin="8,6,8,8"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"/>
            </Grid>
        </Border>

            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    CornerRadius="3"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBg}">
            <Grid>
                <TextBlock Text="HEXAGRAM DISPLAY"
                           Foreground="{StaticResource MutedGreen}"
                           FontSize="12"
                           Margin="10,8,0,0"/>
                <Image x:Name="hexagramImage"
                       Margin="8,24,8,8"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>
                <Rectangle Margin="6,24,6,6"
                           IsHitTestVisible="False"
                           Stroke="#112818"
                           StrokeThickness="1"
                           Opacity="0.6"/>
            </Grid>
        </Border>

            <Rectangle Grid.RowSpan="3"
                       IsHitTestVisible="False"
                       Opacity="0.08">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="0.02"/>
                        <GradientStop Color="#000000" Offset="0.02"/>
                        <GradientStop Color="#000000" Offset="0.04"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Rectangle x:Name="FrameGlow"
                   Grid.RowSpan="2"
                   Margin="2"
                   IsHitTestVisible="False"
                   Stroke="#39FF14"
                   StrokeThickness="1.2"
                   StrokeDashArray="4 3"
                   Opacity="0.6">
            <Rectangle.Effect>
                <DropShadowEffect Color="#39FF14"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.6"/>
            </Rectangle.Effect>
        </Rectangle>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="FrameGlow"
                                     Storyboard.TargetProperty="StrokeDashOffset"
                                     From="0"
                                     To="-14"
                                     Duration="0:0:2"/>
                    <DoubleAnimation Storyboard.TargetName="FrameGlow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.45"
                                     To="0.8"
                                     AutoReverse="True"
                                     Duration="0:0:1.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
