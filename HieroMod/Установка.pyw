# -*- coding: utf-8 -*-
"""Единый установщик: мод «Египетские иероглифы для Skyrim»
(Писец + шрифт + конфиги + плагин + MO2) и программа «Карта снов»
(дневник снов с ИИ, картой-сферой и библиотекой Скайрима)."""
import os, sys, json, shutil, subprocess, winreg
import tkinter as tk
from tkinter import messagebox, simpledialog

SILENT = "-s" in sys.argv
# режим удаления: флаг -u или запуск копии, названной «Удаление …»
UNINSTALL = "-u" in sys.argv or "Удаление" in os.path.basename(
    sys.executable if getattr(sys, "frozen", False) else sys.argv[0])

if getattr(sys, "frozen", False):
    RES = sys._MEIPASS
else:
    RES = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, RES)

from hiero_core import desktop_dir, paths_report

DESKTOP = desktop_dir()
# комплект живёт в LOCALAPPDATA (как и «Карта снов») — на рабочем столе только ярлыки
TARGET = os.path.join(os.environ.get("LOCALAPPDATA", DESKTOP), "HieroMod")
LEGACY_TARGET = os.path.join(DESKTOP, "HieroMod")   # старые установки жили на столе

# Правильный порядок модов (modlist.txt: первый = высший приоритет) и плагинов (plugins.txt)
MODLIST_ORDER = [
    "Египетские иероглифы",
    "Призрачный страж",
    "Мир без вражды",
    "Artaum_S04-1.7(RUS)SSE",
    "Artaum_S04-1.7(pharseaUpdate)SSE",
    "Alternate Start - Live Another Life v4.2.5 AE RU",
    "Alternate Start - Live Another Life",
    "Unofficial Skyrim Special Edition Patch - RUS",
    "Unofficial Skyrim Special Edition Patch",
    "Peaceful Living",
]
PLUGINS_ORDER = [
    "unofficial skyrim special edition patch.esp",
    "Artaeum.esp",
    "alternate start - live another life.esp",
    "PeacefulLiving.esp",
    "No Hostility - Skyrim.esp",
    "No Hostility - Dawnguard.esp",
    "No Hostility - HearthFires.esp",
    "No Hostility - Dragonborn.esp",
    "HieroBooks.esp",
    "GhostGuard.esp",
]


def install_mods_pack():
    """Ставит все моды комплекта и выправляет порядок в modlist.txt / plugins.txt."""
    import hiero_core as hc
    acts = []
    pack = os.path.join(RES, "mods_pack")
    if os.path.isdir(pack) and hc.MODS_DIR:
        os.makedirs(hc.MODS_DIR, exist_ok=True)
        for name in os.listdir(pack):
            src = os.path.join(pack, name)
            dst = os.path.join(hc.MODS_DIR, name)
            if os.path.isdir(src) and not os.path.exists(dst):
                shutil.copytree(src, dst)
                acts.append("мод установлен: " + name)

    prof = os.path.join(hc.PROFILES_DIR, hc.PROFILE) if hc.PROFILES_DIR else ""
    if prof and os.path.isdir(prof):
        # modlist.txt: наши моды в правильном порядке сверху, остальное (DLC, чужое) — следом
        ml = os.path.join(prof, "modlist.txt")
        old = []
        if os.path.exists(ml):
            old = open(ml, encoding="utf-8-sig").read().splitlines()
        header = [l for l in old if l.startswith("#")] or \
                 ["# This file was automatically generated by Mod Organizer."]
        rest = [l for l in old
                if l and not l.startswith("#") and l.lstrip("+-") not in MODLIST_ORDER]
        new = header + ["+" + m for m in MODLIST_ORDER] + rest
        if new != old:
            open(ml, "w", encoding="utf-8").write("\n".join(new) + "\n")
            acts.append("MO2: modlist.txt — порядок модов выправлен")
        # plugins.txt: наш порядок загрузки, чужие плагины — после
        pl = os.path.join(prof, "plugins.txt")
        oldp = []
        if os.path.exists(pl):
            oldp = open(pl, encoding="utf-8-sig", errors="replace").read().splitlines()
        pheader = [l for l in oldp if l.startswith("#")] or \
                  ["# This file was automatically generated by Mod Organizer."]
        prest = [l for l in oldp
                 if l and not l.startswith("#") and l.lstrip("*") not in PLUGINS_ORDER]
        newp = pheader + ["*" + p for p in PLUGINS_ORDER] + prest
        if newp != oldp:
            open(pl, "w", encoding="ascii", errors="ignore").write("\n".join(newp) + "\n")
            acts.append("MO2: plugins.txt — порядок загрузки выправлен")
    return acts

def main():
    actions = ["— пути —\n" + paths_report() + "\n"]
    os.makedirs(TARGET, exist_ok=True)

    # 1) Писец.exe
    os.makedirs(TARGET, exist_ok=True)
    src_pisets = os.path.join(RES, "Писец.exe")
    dst_pisets = os.path.join(TARGET, "Писец.exe")
    if os.path.exists(src_pisets):
        if os.path.abspath(src_pisets) != os.path.abspath(dst_pisets):
            try:
                shutil.copy2(src_pisets, dst_pisets)
                actions.append("Писец.exe -> " + TARGET)
            except PermissionError:
                actions.append("Писец.exe уже запущен — оставлен прежний")

    # 2) мод, шрифты, MO2
    from hiero_core import ensure_installed
    actions += ensure_installed() or ["комплект мода уже установлен"]

    # 2а) все моды комплекта + правильная сортировка в MO2
    actions += install_mods_pack() or ["моды комплекта уже стоят, порядок верный"]

    # 2б) ключ OpenRouter для перевода папирусов (можно пропустить)
    import hiero_translate
    cfg = hiero_translate.load_config()
    if not (cfg.get("api_key") or "").strip() and not SILENT:
        root = tk.Tk(); root.withdraw()
        key = simpledialog.askstring(
            "Перевод папирусов",
            "Ключ OpenRouter API для перевода иероглифов (sk-or-...).\n"
            "Нужен только тому, кто создаёт переводы в Писце;\n"
            "для чтения книг не требуется. Можно пропустить —\n"
            "ключ вписывается позже в openrouter.json или при первом переводе.",
            parent=root)
        root.destroy()
        if key and key.strip():
            cfg["api_key"] = key.strip()
            json.dump(cfg, open(hiero_translate.CONFIG, "w", encoding="utf-8"),
                      ensure_ascii=False, indent=1)
            actions.append("ключ OpenRouter сохранён в openrouter.json")
        else:
            actions.append("ключ OpenRouter пропущен (перевод спросит его сам)")

    # 2в) программа «Карта снов» (дневник снов + библиотека Скайрима)
    src_dm = os.path.join(RES, "dreammap")
    if os.path.isdir(src_dm):
        appdir = os.path.join(os.environ.get("LOCALAPPDATA", TARGET), "DreamMap")
        os.makedirs(appdir, exist_ok=True)
        busy = False
        for f in os.listdir(src_dm):
            s = os.path.join(src_dm, f)
            try:
                if os.path.isdir(s):  # напр. x64\pdfium.dll — рендер PDF-библиотеки
                    shutil.copytree(s, os.path.join(appdir, f), dirs_exist_ok=True)
                else:
                    shutil.copy2(s, os.path.join(appdir, f))
            except PermissionError:
                busy = True  # программа запущена — файлы оставлены прежние
        lnk_dm = os.path.join(DESKTOP, "DreamMap.lnk")
        exe_dm = os.path.join(appdir, "DreamMap.exe")
        ps_dm = ("$ws = New-Object -ComObject WScript.Shell; "
                 f"$l = $ws.CreateShortcut('{lnk_dm}'); "
                 f"$l.TargetPath = '{exe_dm}'; "
                 f"$l.WorkingDirectory = '{appdir}'; $l.Save()")
        subprocess.run(["powershell", "-NoProfile", "-Command", ps_dm],
                       creationflags=0x08000000)
        actions.append("«Карта снов» -> " + appdir +
                       (" (была запущена, файлы прежние)" if busy else "") +
                       ", ярлык на рабочем столе")

    # 3) ярлык на рабочем столе
    lnk = os.path.join(DESKTOP, "Писец.lnk")
    ps = ("$ws = New-Object -ComObject WScript.Shell; "
          f"$l = $ws.CreateShortcut('{lnk}'); "
          f"$l.TargetPath = '{dst_pisets}'; "
          f"$l.WorkingDirectory = '{TARGET}'; $l.Save()")
    subprocess.run(["powershell", "-NoProfile", "-Command", ps],
                   creationflags=0x08000000)
    actions.append("ярлык «Писец» на рабочем столе")

    # 4) деинсталлятор — копия установщика под именем «Удаление …»
    if getattr(sys, "frozen", False):
        try:
            shutil.copy2(sys.executable,
                         os.path.join(TARGET, "Удаление Иероглифы и Карта снов.exe"))
            actions.append("деинсталлятор: HieroMod\\Удаление Иероглифы и Карта снов.exe")
        except OSError:
            pass
    return actions


def uninstall():
    """Полное удаление: мод, Писец, «Карта снов» и все их данные (программы и игры)."""
    import hiero_core as hc
    acts = []

    for p in ("Писец.exe", "DreamMap.exe", "КартаСнов.exe"):
        subprocess.run(["taskkill", "/f", "/im", p],
                       creationflags=0x08000000, capture_output=True)

    def rmdir(p, label):
        if p and os.path.isdir(p):
            shutil.rmtree(p, ignore_errors=True)
            acts.append(label + ": " + p)

    def rmfile(p, label):
        if p and os.path.isfile(p):
            try:
                os.remove(p)
                acts.append(label)
            except OSError:
                pass

    # 1) программа «Карта снов»: файлы и все данные (сны, картинки, настройки);
    #    старые установки жили в папках «КартаСнов» — чистим оба имени
    rmdir(os.path.join(os.environ.get("LOCALAPPDATA", ""), "DreamMap"), "«Карта снов»")
    rmdir(os.path.join(os.environ.get("LOCALAPPDATA", ""), "КартаСнов"), "«Карта снов» (старая)")
    rmdir(os.path.join(os.environ.get("APPDATA", ""), "DreamMap"), "данные «Карты снов»")
    rmdir(os.path.join(os.environ.get("APPDATA", ""), "КартаСнов"), "данные «Карты снов» (старые)")
    rmfile(os.path.join(DESKTOP, "DreamMap.lnk"), "ярлык DreamMap")
    rmfile(os.path.join(DESKTOP, "Карта снов.lnk"), "ярлык «Карта снов» (старый)")

    # 2) ВСЕ моды комплекта со всеми данными игры (книги, переводы, esp, скрипты, ключ)
    for mod_name in MODLIST_ORDER:
        rmdir(os.path.join(hc.MODS_DIR, mod_name), "мод «%s»" % mod_name)

    # 3) выключение в MO2
    prof = os.path.join(hc.PROFILES_DIR, hc.PROFILE) if hc.PROFILES_DIR else ""
    ml = os.path.join(prof, "modlist.txt") if prof else ""
    if ml and os.path.exists(ml):
        lines = open(ml, encoding="utf-8-sig").read().splitlines()
        keep = [l for l in lines if l.lstrip("+-") not in MODLIST_ORDER]
        if len(keep) != len(lines):
            open(ml, "w", encoding="utf-8").write("\n".join(keep) + "\n")
            acts.append("MO2: моды комплекта убраны из modlist.txt")
    pl = os.path.join(prof, "plugins.txt") if prof else ""
    if pl and os.path.exists(pl):
        lines = open(pl, encoding="utf-8-sig", errors="replace").read().splitlines()
        keep = [l for l in lines if l.lstrip("*") not in PLUGINS_ORDER]
        if len(keep) != len(lines):
            open(pl, "w", encoding="ascii", errors="ignore").write("\n".join(keep) + "\n")
            acts.append("MO2: плагины комплекта убраны из plugins.txt")

    # 4) шрифт Windows: сначала выгружаем из сеанса (иначе файл заблокирован)
    try:
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER,
                            r"Software\Microsoft\Windows NT\CurrentVersion\Fonts",
                            0, winreg.KEY_SET_VALUE) as k:
            winreg.DeleteValue(k, "SkyrimHiero (TrueType)")
        acts.append("шрифт SkyrimHiero убран из реестра")
    except OSError:
        pass
    fpath = os.path.join(os.environ["LOCALAPPDATA"], "Microsoft", "Windows",
                         "Fonts", "SkyrimHiero.ttf")
    if os.path.isfile(fpath):
        import ctypes
        try:
            ctypes.windll.gdi32.RemoveFontResourceW(fpath)
        except OSError:
            pass
        try:
            os.remove(fpath)
            acts.append("шрифт SkyrimHiero.ttf удалён")
        except OSError:
            # всё ещё занят — удалится отложенной командой после выхода
            subprocess.Popen('cmd /c ping -n 5 127.0.0.1 >nul & del /f /q "%s"' % fpath,
                             creationflags=0x08000008)
            acts.append("шрифт SkyrimHiero.ttf будет удалён после выхода")

    # 5) Писец и папка HieroMod (новая и легаси на столе) — отложенно,
    #    деинсталлятор может работать из одной из них
    rmfile(os.path.join(DESKTOP, "Писец.lnk"), "ярлык «Писец»")
    for tdir in {TARGET, LEGACY_TARGET}:
        if os.path.isdir(tdir):
            subprocess.Popen('cmd /c ping -n 4 127.0.0.1 >nul & rd /s /q "%s"' % tdir,
                             creationflags=0x08000008)  # DETACHED + NO_WINDOW
            acts.append("папка Писца будет удалена после выхода: " + tdir)
    return acts

if __name__ == "__main__":
    if UNINSTALL:
        try:
            if not SILENT:
                root = tk.Tk(); root.withdraw()
                ok = messagebox.askyesno("Удаление",
                    "Удалить ПОЛНОСТЬЮ:\n\n"
                    "— ВСЕ моды комплекта: Иероглифы (книги, переводы),\n"
                    "   Мир без вражды, Призрачный страж, Артеум, USSEP,\n"
                    "   Alternate Start, Peaceful Living\n"
                    "— Писца и папку HieroMod\n"
                    "— программу «Карта снов» и ВСЕ её данные (сны, картинки)\n"
                    "— шрифт SkyrimHiero из Windows\n\n"
                    "Отменить будет нельзя. Продолжить?")
                root.destroy()
                if not ok:
                    sys.exit(0)
            acts = uninstall()
            if not SILENT:
                root = tk.Tk(); root.withdraw()
                messagebox.showinfo("Удаление завершено",
                    "Удалено:\n\n— " + "\n— ".join(acts or ["ничего не найдено"]) +
                    "\n\nСохранения Skyrim, где мод был активен, при загрузке\n"
                    "предупредят об отсутствующем плагине — это нормально.")
            else:
                print("\n".join(acts))
        except Exception as e:
            if not SILENT:
                root = tk.Tk(); root.withdraw()
                messagebox.showerror("Удаление", f"Ошибка:\n{e}")
            else:
                print("ОШИБКА:", e)
                sys.exit(1)
        sys.exit(0)
    try:
        actions = main()
        if not SILENT:
            root = tk.Tk(); root.withdraw()
            messagebox.showinfo("Установка завершена",
                "Комплект «Иероглифы + Карта снов» установлен:\n\n— " +
                "\n— ".join(actions) +
                "\n\nЗапускайте «Писец» и «Карту снов» с рабочего стола.\n"
                "В игре книги выдаются командой консоли:  bat bookN\n"
                "В «Карте снов» кнопка «𓉐 Библиотека» читает книги мода\n"
                "и пишет трактовки ИИ обратно в мод.")
        else:
            print("\n".join(actions))
    except Exception as e:
        if not SILENT:
            root = tk.Tk(); root.withdraw()
            messagebox.showerror("Установка", f"Ошибка:\n{e}")
        else:
            print("ОШИБКА:", e)
            sys.exit(1)
